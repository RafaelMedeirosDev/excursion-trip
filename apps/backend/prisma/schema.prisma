generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum Role {
  ADM
  EMPLOYEE
}

enum ExcursionStatus {
  PLANNING
  OPEN
  CLOSED
  DONE
  CANCELED
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  WAITLIST
  CANCELED
}

enum PaymentType {
  PAYMENT
  REVERSAL
}

enum PaymentMethod {
  PIX
  CASH
  CARD
}

enum ExpensesCategory {
  FUEL
  TOLL
  FOOD
  SUPPLIES
  OTHER
}

enum UF {
  AC
  AL
  AP
  AM
  BA
  CE
  DF
  ES
  GO
  MA
  MT
  MS
  MG
  PA
  PB
  PR
  PE
  PI
  RJ
  RN
  RS
  RO
  RR
  SC
  SP
  SE
  TO
}

// ---------- Models ----------

model Organization {
  id   String  @id @default(uuid())
  name String
  cnpj String? @unique

  users           User[]
  suppliers       Supplier[]
  customers       Customer[]
  events          Event[]
  excursions      Excursion[]
  vehicleBookings VehicleBooking[]
  expenses        Expense[]
  boardingPoints  BoardingPoint[]
  reservations    Reservation[]
  payments        Payment[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

model User {
  id             String @id @default(uuid())
  organizationId String

  name     String
  email    String @unique
  password String
  phone    String
  cpf      String
  role     Role

  organization Organization @relation(fields: [organizationId], references: [id])

  excursions      Excursion[]
  vehicleBookings VehicleBooking[]
  reservations    Reservation[]
  payments        Payment[]
  expenses        Expense[]
  refreshTokens   RefreshToken[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([organizationId, cpf])
  @@index([organizationId])
}

model RefreshToken {
  id     String @id @default(uuid())
  userId String

  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([tokenHash])
}

model Supplier {
  id             String  @id @default(uuid())
  organizationId String
  name           String
  cnpj           String
  address        String?
  phone          String

  organization Organization @relation(fields: [organizationId], references: [id])

  vehicleBookings VehicleBooking[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([organizationId, cnpj])
  @@index([organizationId])
}

model Customer {
  id             String  @id @default(uuid())
  organizationId String
  name           String
  email          String?
  phone          String
  cpf            String

  organization Organization @relation(fields: [organizationId], references: [id])

  reservations Reservation[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([organizationId, cpf])
  @@index([organizationId])
}

model Event {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  address        String
  city           String
  state          UF
  startDate      DateTime
  endDate        DateTime
  startTime      String
  endTime        String

  organization Organization @relation(fields: [organizationId], references: [id])

  excursions Excursion[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([organizationId])
}

model Excursion {
  id             String @id @default(uuid())
  organizationId String
  eventId        String
  userId         String

  name          String
  departureDate DateTime
  returnDate    DateTime
  status        ExcursionStatus @default(PLANNING)
  canceledAt    DateTime?
  cancelReason  String?

  organization Organization @relation(fields: [organizationId], references: [id])
  event        Event        @relation(fields: [eventId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  vehicleBookings VehicleBooking[]
  expenses        Expense[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([eventId])
  @@index([userId])
}

model VehicleBooking {
  id             String @id @default(uuid())
  organizationId String
  supplierId     String
  excursionId    String
  userId         String

  vehicleType String
  plate       String?
  capacity    Int
  value       Int
  startTime   String?
  returnTime  String?
  price       Int

  organization Organization @relation(fields: [organizationId], references: [id])
  supplier     Supplier     @relation(fields: [supplierId], references: [id])
  excursion    Excursion    @relation(fields: [excursionId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  boardingPoints BoardingPoint[]
  reservations   Reservation[]
  expenses       Expense[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([excursionId, plate])
  @@index([organizationId])
  @@index([supplierId])
  @@index([excursionId])
  @@index([userId])
}

model BoardingPoint {
  id               String @id @default(uuid())
  organizationId   String
  vehicleBookingId String

  address String
  time    String?

  organization   Organization   @relation(fields: [organizationId], references: [id])
  vehicleBooking VehicleBooking @relation(fields: [vehicleBookingId], references: [id])

  reservations Reservation[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([organizationId])
  @@index([vehicleBookingId])
}

model Reservation {
  id               String  @id @default(uuid())
  organizationId   String
  userId           String
  customerId       String
  vehicleBookingId String
  boardingPointId  String?

  status       ReservationStatus @default(WAITLIST)
  agreedValue  Int
  canceledAt   DateTime?
  cancelReason String?

  organization   Organization   @relation(fields: [organizationId], references: [id])
  user           User           @relation(fields: [userId], references: [id])
  customer       Customer       @relation(fields: [customerId], references: [id])
  vehicleBooking VehicleBooking @relation(fields: [vehicleBookingId], references: [id])
  boardingPoint  BoardingPoint? @relation(fields: [boardingPointId], references: [id])

  payments Payment[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([vehicleBookingId, customerId])
  @@index([organizationId])
  @@index([userId])
  @@index([customerId])
  @@index([vehicleBookingId])
  @@index([boardingPointId])
}

model Payment {
  id             String @id @default(uuid())
  organizationId String
  reservationId  String
  userId         String

  type   PaymentType
  value  Int
  method PaymentMethod

  organization Organization @relation(fields: [organizationId], references: [id])
  reservation  Reservation  @relation(fields: [reservationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([reservationId])
  @@index([userId])
}

model Expense {
  id               String  @id @default(uuid())
  organizationId   String
  vehicleBookingId String?
  excursionId      String
  userId           String

  category    ExpensesCategory
  value       Int
  description String

  organization   Organization    @relation(fields: [organizationId], references: [id])
  vehicleBooking VehicleBooking? @relation(fields: [vehicleBookingId], references: [id])
  excursion      Excursion       @relation(fields: [excursionId], references: [id])
  user           User            @relation(fields: [userId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([organizationId])
  @@index([vehicleBookingId])
  @@index([excursionId])
  @@index([userId])
}
